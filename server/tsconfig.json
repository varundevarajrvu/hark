{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["./**/*.ts", "../shared/**/*.ts", "../tests/**/*.ts"]
}
