<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight: native screens, and the status/navigation bar icons, follow the system theme. -->
    <style name="Theme.Vector" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
    </style>

    <style name="Widget.Vector.PrimaryButton" parent="Widget.AppCompat.Button.Colored">
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Vector.TextButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
