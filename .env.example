# ── Pick ONE model provider (or VECTOR_MOCK_LLM=1 for the scripted demo) ──

# Free: Google Gemini. Key from https://aistudio.google.com/apikey — default model gemini-3.8-flash.
# On the free tier Google uses your content to improve its products.
GEMINI_API_KEY=

# Free: Groq. Key from https://console.groq.com/keys — default model openai/gpt-oss-120b.
# GROQ_API_KEY=

# Paid: Claude. Default model claude-fable-5-2.
# ANTHROPIC_API_KEY=

# Any other OpenAI-compatible server (Ollama, OpenRouter…)
# VECTOR_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# VECTOR_OPENAI_API_KEY=

# Force a provider when several keys are set: anthropic | gemini | groq | openai-compatible
# VECTOR_PROVIDER=gemini
# Override the provider's default model
# VECTOR_MODEL=
# Claude only: how hard it thinks (low | medium | high | xhigh | max)
# VECTOR_EFFORT=high

# Scripted offline model: explore the whole product with no API calls
# VECTOR_MOCK_LLM=1

# Where the database, vault key and screenshots live
# VECTOR_DATA_DIR=./data
# 32 random bytes, base64. If unset, one is generated at <data dir>/master.key
# VECTOR_MASTER_KEY=

# Network
# PORT=8787
# HOST=127.0.0.1
# VECTOR_PUBLIC_ORIGIN=https://vector.example.com
# VECTOR_ALLOW_SIGNUP=0

# Browser agent
# VECTOR_CHROMIUM_PATH=/path/to/chromium
# VECTOR_HANDOFF_MAX_STEPS=40

# Claude only: set to 0 if your API account rejects these beta features
# VECTOR_FALLBACKS=0
# VECTOR_COMPACTION=0

# Phone on the same Wi-Fi: listen on all interfaces and open http://<laptop-ip>:8787 from the app
# HOST=0.0.0.0
# Behind a reverse proxy with HTTPS: set the public origin (also turns on Secure cookies)
# VECTOR_TRUST_PROXY=1
