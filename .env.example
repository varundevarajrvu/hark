# Claude API credentials (required unless VECTOR_MOCK_LLM=1)
ANTHROPIC_API_KEY=

# Model used by every agent, and how hard it thinks (low | medium | high | xhigh | max)
VECTOR_MODEL=claude-fable-5-2
VECTOR_EFFORT=high

# Scripted offline model: explore the whole product with no API calls
# VECTOR_MOCK_LLM=1

# Where the database, vault key and screenshots live
# VECTOR_DATA_DIR=./data
# 32 random bytes, base64. If unset, one is generated at <data dir>/master.key
# VECTOR_MASTER_KEY=

# Network
# PORT=8787
# HOST=127.0.0.1
# VECTOR_PUBLIC_ORIGIN=https://vector.example.com
# VECTOR_ALLOW_SIGNUP=0

# Browser agent
# VECTOR_CHROMIUM_PATH=/path/to/chromium
# VECTOR_HANDOFF_MAX_STEPS=40

# Set to 0 if your API account rejects these beta features
# VECTOR_FALLBACKS=0
# VECTOR_COMPACTION=0
